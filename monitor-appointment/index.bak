import * as fs from 'fs';
import mysql from 'mysql2/promise';
import { createClient } from 'redis';

// --- Configuration Constants ---
const CHECK_INTERVAL_MS = 60000; // Check every 1 minute
const mophAlertUrl = process.env.MOPH_ALERT_URL;

console.log("Initializing Appointment Monitor Service...");

// --- 1. Safely Load Secrets ---
let clientSecret = '';
try {
    clientSecret = fs.readFileSync('./jwt/client-secret.jwt', 'utf8').trim();
} catch (err) {
    console.error("CRITICAL: Failed to read client secret:", err.message);
    process.exit(1);
}

function getSecret(filePath, secretName) {
    try {
        const secret = fs.readFileSync(filePath, 'utf8').trim();
        if (!secret) throw new Error("File is empty");
        console.log(`Successfully read ${secretName} from secret.`);
        return secret;
    } catch (err) {
        console.error(`CRITICAL: Failed to read ${secretName}:`, err.message);
        process.exit(1);
    }
}

const hosxpPassword = getSecret('/run/secrets/hosxp-db-password', 'HOSxP DB password');
const redisPassword = getSecret('/run/secrets/redis-subscribe', 'Redis password');

// --- 2. Initialize Connections ---
const redisClient = createClient({
    socket: {
        host: 'redis-subscribe',
        port: 6379
    },
    password: redisPassword
});

redisClient.on('error', err => console.error('Redis Client Error', err));

const hosDb = mysql.createPool({
    host: process.env.HOSXP_HOST,
    user: process.env.HOSXP_USER,
    database: process.env.HOSXP_DATABASE,
    password: hosxpPassword,
    charset: process.env.HOSXP_CHAR_SET,
    connectionLimit: 10
});

// --- 3. Core Monitor Logic ---
async function startMonitor() {
    try {
        await redisClient.connect();
        console.log('Redis Client Connected');
    } catch (err) {
        console.error('Failed to connect to Redis:', err);
        process.exit(1);
    }

    console.log("Starting Appointment Monitor loop...");

    async function check() {
        try {
            console.log("Scanning active visits for new appointments...");
            const keys = await redisClient.keys('active_visit:*');

            if (!keys || keys.length === 0) return;

            for (const key of keys) {
                const keyString = String(key);
                const vn = keyString.split(':')[1];
                const visitData = await redisClient.hGetAll(keyString);

                // Skip if missing essential data
                if (!visitData || !vn) continue;

                // Parse the array of already notified appointment IDs
                // Default to empty array if undefined to prevent crashes
                let notifiedOapps = [];
                try {
                    notifiedOapps = JSON.parse(visitData.notified_oapps || '[]');
                } catch (e) {
                    console.error(`Error parsing notified_oapps for VN ${vn}`, e);
                    notifiedOapps = [];
                }

                // Query the database for ALL appointments for this VN
                const [appointments] = await hosDb.query(
                    `SELECT 
                        oapp.oapp_id, 
                        DATE_FORMAT(oapp.nextdate, '%Y-%m-%d') as nextdate, 
                        oapp.nexttime, 
                        clinic.name as clinic_name, 
                        kskdepartment.department as department_name, 
                        doctor.name as doctor_name, 
                        spclty.name as spclty_name, 
                        oapp.app_cause, 
                        oapp.contact_point, 
                        oapp.note, 
                        oapp.note1, 
                        oapp.note2
                    FROM oapp
                    INNER JOIN doctor ON doctor.code = oapp.doctor
                    INNER JOIN clinic ON clinic.clinic = oapp.clinic
                    INNER JOIN kskdepartment ON kskdepartment.depcode = oapp.depcode
                    INNER JOIN spclty ON spclty.spclty = oapp.spclty
                    WHERE vn = ?;`,
                    [vn]
                );

                // IMPORTANT: Filter out appointments we've already sent an alert for
                const newAppointments = appointments.filter(app => !notifiedOapps.includes(app.oapp_id));

                if (newAppointments.length > 0) {
                    console.log(`Found ${newAppointments.length} NEW appointment(s) for VN: ${vn}. Sending message...`);

                    let messageHTML = `<strong><p>HN ${visitData.hn}</p><p>คุณ${visitData.fname} ${visitData.lname}</p><p>รายการนัดหมายใหม่:</p><br></strong>`;
                    let messageText = `คุณ${visitData.fname} ${visitData.lname} มีนัดหมายใหม่\n`;
                    let flexAppointmentBoxes = [];

                    // Loop through ONLY the new appointments
                    newAppointments.forEach((app, index) => {
                        const cause = app.app_cause || 'ไม่ระบุ';
                        const doc = app.doctor_name || '-';

                        messageHTML += `<p>📅 วันที่: ${app.nextdate} เวลา: ${app.nexttime} น.</p>`;
                        messageHTML += `<p>🏥 คลินิก: ${app.clinic_name}</p>`;
                        messageHTML += `<p>👨‍⚕️ แพทย์: ${doc}</p>`;
                        messageHTML += `<p>📝 สาเหตุ: ${cause}</p><br>`;

                        messageText += `วันที่ ${app.nextdate} เวลา ${app.nexttime} น. ที่ ${app.clinic_name}\n`;

                        flexAppointmentBoxes.push({
                            type: "box",
                            layout: "vertical",
                            margin: "md",
                            spacing: "sm",
                            contents: [
                                {
                                    type: "text",
                                    text: `📅 ${app.nextdate} ⏰ ${app.nexttime}`,
                                    weight: "bold",
                                    size: "sm",
                                    color: "#198754"
                                },
                                { type: "text", text: `🏥 คลินิก: ${app.clinic_name}`, size: "xs", color: "#666666", wrap: true },
                                { type: "text", text: `👨‍⚕️ แพทย์: ${doc}`, size: "xs", color: "#666666", wrap: true },
                                { type: "text", text: `📝 สาเหตุ: ${cause}`, size: "xs", color: "#666666", wrap: true }
                            ]
                        });

                        if (index < newAppointments.length - 1) {
                            flexAppointmentBoxes.push({ type: "separator", margin: "md" });
                        }
                    });

                    const payload = {
                        cid: [visitData.cid],
                        messages: [
                            {
                                type: "flex",
                                altText: "แจ้งเตือนการนัดหมายครั้งต่อไป",
                                contents: {
                                    type: "bubble",
                                    body: {
                                        type: "box",
                                        layout: "vertical",
                                        contents: [
                                            { type: "text", text: "รายการนัดหมายใหม่", weight: "bold", size: "xl", color: "#0d6efd", align: "center" },
                                            { type: "text", text: `คุณ${visitData.fname} ${visitData.lname} (HN ${visitData.hn})`, size: "sm", color: "#666666", align: "center", margin: "sm" },
                                            { type: "separator", margin: "md" },
                                            ...flexAppointmentBoxes
                                        ]
                                    }
                                }
                            }
                        ],
                        "message_title": "แจ้งเตือนการนัดหมาย",
                        "message_text": messageText.trim(),
                        "message_html": messageHTML,
                        "message_type": "HPT"
                    };

                    try {
                        const response = await fetch(mophAlertUrl, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'Authorization': `Bearer ${clientSecret}`
                            },
                            body: JSON.stringify(payload)
                        });

                        if (response.ok) {
                            // Combine previously notified IDs with the newly notified IDs
                            const newOappIds = newAppointments.map(app => app.oapp_id);
                            const updatedOapps = [...notifiedOapps, ...newOappIds];

                            // Save the updated list back to Redis
                            await redisClient.hSet(keyString, 'notified_oapps', JSON.stringify(updatedOapps));

                            console.log(`Successfully notified VN: ${vn} of appointments: ${newOappIds.join(', ')}`);
                        } else {
                            console.error(`Failed to notify VN: ${vn}. Status: ${response.status}`);
                        }
                    } catch (fetchErr) {
                        console.error(`Network error notifying VN: ${vn}`, fetchErr);
                    }
                }
            }
        } catch (error) {
            console.error("Error during appointment monitor cycle:", error);
        } finally {
            setTimeout(check, CHECK_INTERVAL_MS);
        }
    }

    // Kick off cycle
    check();
}

startMonitor();